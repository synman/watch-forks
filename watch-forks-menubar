def interval_label(sec: float) -> str:
    """Display label for an interval choice — "Manual" for the 0.0 sentinel,
    "Ns" otherwise. Used as both the menu item title and the radio key."""
    return "Manual" if sec <= 0 else f"{sec:g}s"


def parse_pcpu(s: str) -> float:
    """ps reports `%CPU` as a string like `12.3`. Coerce to float;
    malformed values (rare — ps returns `-` for some kernel threads)
    map to 0.0 so the row still ranks and renders."""
    try:
        return float(s)
    except (TypeError, ValueError):
        return 0.0

