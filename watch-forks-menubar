# --- Per-PID binary path + icon cache ---
#
# resolve_pid_icon() is called once per PID (on row creation) and its result
# is cached so we never re-run ps on every tick. The cache is a plain dict;
# PIDs are ephemeral so the dict stays small (bounded by top-N).

_pid_icon_cache: dict[int, NSImage] = {}
_pid_binary_cache: dict[int, str] = {}

_FALLBACK_ICON_NAME = "gearshape.fill"


def _resolve_binary_path(pid: int) -> str:
    """Return the full executable path for `pid` via `ps -o comm= -p <pid>`.
    Returns an empty string on any error — callers must handle the empty case."""
    if pid in _pid_binary_cache:
        return _pid_binary_cache[pid]
    try:
        result = subprocess.run(
            ["ps", "-o", "comm=", "-p", str(pid)],
            capture_output=True, text=True, timeout=2
        )
        path = result.stdout.strip()
    except Exception:
        path = ""
    _pid_binary_cache[pid] = path
    return path


def _resolve_pid_icon(pid: int) -> NSImage:
    """Return an NSImage for the process icon, cached by PID.

    For processes whose binary lives inside a .app bundle we use
    NSWorkspace.iconForFile_() on the bundle path; everything else falls
    back to the SF Symbols terminal / gearshape glyph."""
    if pid in _pid_icon_cache:
        return _pid_icon_cache[pid]

    icon = None
    path = _resolve_binary_path(pid)
    if path:
        # Walk up from the binary to the enclosing .app bundle — a typical
        # macOS app binary lives at Foo.app/Contents/MacOS/Foo.
        parts = path.split("/")
        for i, part in enumerate(parts):
            if part.endswith(".app"):
                bundle_path = "/".join(parts[: i + 1])
                icon = NSWorkspace.sharedWorkspace().iconForFile_(bundle_path)
                break

    if icon is None:
        # Try SF Symbols "terminal" for CLI processes, fall back to gearshape.
        icon = NSImage.imageWithSystemSymbolName_accessibilityDescription_(
            "terminal", None
        )
        if icon is None:
            icon = NSImage.imageWithSystemSymbolName_accessibilityDescription_(
                _FALLBACK_ICON_NAME, None
            )

    _pid_icon_cache[pid] = icon
    return icon


def _severity_sf_symbol(severity: str) -> tuple[str, NSColor]:
    """Return (SF Symbol name, tint color) for a severity string."""
    if severity == "hot":
        return "flame.fill", NSColor.systemRedColor()
    if severity == "warm":
        return "thermometer.medium", NSColor.systemOrangeColor()
    # cold (default)
    return "snowflake", NSColor.systemBlueColor()


def _make_severity_image(severity: str) -> Optional[NSImage]:
    """Build a tinted SF Symbols image for the given severity."""
    name, color = _severity_sf_symbol(severity)
    img = NSImage.imageWithSystemSymbolName_accessibilityDescription_(name, None)
    if img is None:
        return None
    # Apply a hierarchical rendering configuration with the target color.
    try:
        cfg = objc.lookUpClass("NSImageSymbolConfiguration")
        hierarchical = cfg.configurationWithHierarchicalColor_(color)
        return img.imageWithSymbolConfiguration_(hierarchical)
    except Exception:
        # Fallback: return un-tinted image if symbol configuration unavailable.
        return img


def _heat_color(fraction: float) -> NSColor:
    """Return a semantic system color on the heat scale: blue → orange → red.

    Uses dynamic NSColor.system* colors so the fill adapts automatically in
    light and dark mode — no hardcoded RGB values."""
    frac = max(0.0, min(1.0, fraction))
    if frac <= 0.33:
        return NSColor.systemBlueColor()
    if frac <= 0.66:
        return NSColor.systemOrangeColor()
    return NSColor.systemRedColor()


# --- SparklineView ---

class SparklineView(NSView):
    """Custom NSView that draws a mini line/area chart of fork-count history.

    Samples are a list of (timestamp, forks_n) tuples — the same format as
    pid_history deque entries. Up to _MAX_SAMPLES are shown; if fewer than
    2 samples are available the view renders blank. Color tracks severity.
    """

    _MAX_SAMPLES = 48  # bumped from 16 — denser sparkline given the 5min window

    def initWithFrame_(self, frame):  # noqa: N802
        self = objc.super(SparklineView, self).initWithFrame_(frame)
        if self is None:
            return None
        self._samples: list[tuple[float, int]] = []
        self._severity: str = "cold"
        return self

    def setSamples_severity_(self, samples, severity):  # noqa: N802
        """Update display data and trigger a redraw. samples is a list of
        (timestamp, forks_n) tuples; severity is 'cold'/'warm'/'hot'."""
        # Keep only the last _MAX_SAMPLES.
        self._samples = list(samples)[-self._MAX_SAMPLES:]
        self._severity = severity
        self.setNeedsDisplay_(True)

    def drawRect_(self, dirty_rect):  # noqa: N802
        NSColor.clearColor().setFill()
        NSBezierPath.fillRect_(self.bounds())

        samples = self._samples
        if len(samples) < 2:
            return

        bounds = self.bounds()
        w = bounds.size.width
        h = bounds.size.height
        pad_v = 1.5  # vertical padding (px)

        values = [s[1] for s in samples]
        v_min = min(values)
        v_max = max(values)
        v_range = max(v_max - v_min, 1)  # avoid divide-by-zero

        n = len(samples)

        def x_for(i):
            return (i / (n - 1)) * w

        def y_for(v):
            return pad_v + ((v - v_min) / v_range) * (h - 2 * pad_v)

        # Determine line + fill color from severity.
        _, color = _severity_sf_symbol(self._severity)
        line_color = color
        fill_color = color.colorWithAlphaComponent_(0.25)

        # Build the closed fill path first (under the line).
        fill_path = NSBezierPath.bezierPath()
        fill_path.moveToPoint_((x_for(0), 0.0))
        for i, (_, v) in enumerate(samples):
            fill_path.lineToPoint_((x_for(i), y_for(v)))
        fill_path.lineToPoint_((x_for(n - 1), 0.0))
        fill_path.closePath()
        fill_color.setFill()
        fill_path.fill()

        # Draw the line on top.
        line_path = NSBezierPath.bezierPath()
        line_path.setLineWidth_(1.5)
        line_path.moveToPoint_((x_for(0), y_for(samples[0][1])))
        for i, (_, v) in enumerate(samples[1:], 1):
            line_path.lineToPoint_((x_for(i), y_for(v)))
        line_color.setStroke()
        line_path.stroke()


