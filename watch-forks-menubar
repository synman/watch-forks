def parse_pcpu(s: str) -> float:
    """ps reports `%CPU` as a string like `12.3`. Coerce to float;
    malformed values (rare — ps returns `-` for some kernel threads)
    map to 0.0 so the row still ranks and renders."""
    try:
        return float(s)
    except (TypeError, ValueError):
        return 0.0

