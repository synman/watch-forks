# NSAlert.runModal() return constants
NS_ALERT_FIRST = 1000
NS_ALERT_SECOND = 1001


def floating_alert(
    title: str, message: str = "", ok: str = "OK", cancel: Optional[str] = None
) -> int:
    """rumps.alert replacement that always comes up on top.

    Two tricks combine: NSApp.activateIgnoringOtherApps_(True) brings the
    menubar app to the front so its modal is positioned correctly, and
    setting the alert window's level to NSFloatingWindowLevel ensures it
    stays above other apps' regular windows even if focus shifts.

    Returns 1 for the first button (`ok`), 0 for the second (`cancel`),
    matching the rumps.alert convention this replaces.
    """
    NSApp.activateIgnoringOtherApps_(True)
    alert = NSAlert.alloc().init()
    alert.setMessageText_(title)
    if message:
        alert.setInformativeText_(message)
    alert.addButtonWithTitle_(ok)
    if cancel:
        alert.addButtonWithTitle_(cancel)
    # layout() forces the panel to be created so we can reach its window.
    alert.layout()
    win = alert.window()
    if win is not None:
        win.setLevel_(NSFloatingWindowLevel)
    response = alert.runModal()
    return 1 if response == NS_ALERT_FIRST else 0

