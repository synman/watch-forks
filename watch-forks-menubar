# Title color is plain text; emoji prefix encodes severity.
SEV_NORMAL = "❄️"  # ❄️ — steady state
SEV_WARN = "🌡️"   # 🌡️ — rising
SEV_HOT = "🔥"     # 🔥 — fork-bomb territory


# Severity is rate-based with hysteresis, not absolute. The icon reflects
# the rolling expansion/compaction rate of the total process count (procs/s,
# smoothed over RATE_WINDOW_SECONDS), and is sticky — it only flips on a
# rise or fall transition crossing the asymmetric thresholds below.
#
#   cold (❄️) ──[rate ≥ RATE_WARM_ENTRY]──▶ warm (🌡️)
#   warm (🌡️) ──[rate ≥ RATE_HOT_ENTRY ]──▶ hot  (🔥)
#   warm (🌡️) ──[rate ≤ RATE_COOL_ENTRY]──▶ cold (❄️)
#   hot  (🔥) ──[rate < RATE_HOT_ENTRY ]──▶ warm (🌡️)
#
# A flatline (rate ≈ 0) holds the current state; only a real rise/fall
# event crosses a threshold. hot never drops directly to cold — it has to
# cool through warm, which prevents flapping on a single quiet sample.
RATE_WINDOW_SECONDS = 30.0
RATE_WARM_ENTRY = 1.0   # ≥ +1 proc/s sustained → warming
RATE_HOT_ENTRY = 5.0    # ≥ +5 proc/s sustained → hot
RATE_COOL_ENTRY = 0.0   # ≤ 0 proc/s (flatline or compaction) → cools warm→cold

# Per-process thresholds — same state machine, scaled smaller since per-PID
# fork counts are typically single-digit. A normal process's children
# fluctuate by < 0.5/s; a fork bomb pushes well past 2/s.
PROC_WARM_ENTRY = 0.5
PROC_HOT_ENTRY = 2.0
PROC_COOL_ENTRY = 0.0

# State → emoji lookup, shared by the menu-bar title and per-row prefix.
SEV_BY_STATE = {"cold": SEV_NORMAL, "warm": SEV_WARN, "hot": SEV_HOT}

# CPU trend indicator — direct delta (current_total_cpu - prior_total_cpu),
# rendered after the % in the title. Asymmetric hysteresis: entry needs a
# clear trend (≥ ±CPU_TREND_ENTRY) but exit needs a real reversal of at
# least CPU_TREND_EXIT in the opposite direction. Flat or sub-threshold
# samples leave the current state alone, so the icon doesn't flap on
# ps reporting jitter (±1-2% per sample is normal).
CPU_TREND_ENTRY = 3.0  # %CPU delta to enter rising/falling from steady
CPU_TREND_EXIT = 1.0   # %CPU opposite-direction delta to drop back to steady
TREND_RISING = "↑"
TREND_FALLING = "↓"
TREND_STEADY = "→"
TREND_BY_STATE = {
    "rising": TREND_RISING,
    "falling": TREND_FALLING,
    "steady": TREND_STEADY,
}


def cpu_trend_state(
    prev: str, delta: float, entry_threshold: float, exit_threshold: float
) -> str:
    """Signed 3-state trend: rising / steady / falling with asymmetric
    hysteresis. From steady, the delta must clear ±entry_threshold to
    enter rising or falling. Once trending, it stays there until the
    delta reverses by at least exit_threshold in the opposite direction —
    so a flat or noisy sample preserves the trend, and only a real
    reversal flips it back to steady."""
    if prev == "rising":
        return "steady" if delta <= -exit_threshold else "rising"
    if prev == "falling":
        return "steady" if delta >= exit_threshold else "falling"
    # steady
    if delta >= entry_threshold:
        return "rising"
    if delta <= -entry_threshold:
        return "falling"
    return "steady"


def apply_hysteresis(
    prev: str, rate: float, warm_entry: float, hot_entry: float, cool_entry: float
) -> str:
    """Sticky 3-state machine driven by rate. Only crosses on the entry
    threshold for the next state — flatline holds the current state.
    hot never falls directly to cold; it has to cool through warm."""
    if prev == "cold" and rate >= warm_entry:
        return "warm"
    if prev == "warm":
        if rate >= hot_entry:
            return "hot"
        if rate <= cool_entry:
            return "cold"
    if prev == "hot" and rate < hot_entry:
        return "warm"
    return prev


def compute_rate(history: "deque[tuple[float, int]]", current_value: int, now: float) -> float:
    """Smoothed rate (units/sec) — uses (current_value - oldest_value) /
    (now - oldest_timestamp), which damps single-sample noise more than
    just diffing consecutive ticks."""
    if not history:
        return 0.0
    t0, n0 = history[0]
    dt = now - t0
    if dt <= 0:
        return 0.0
    return (current_value - n0) / dt


