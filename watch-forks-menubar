class HeatGaugeView(NSView):
    """Colored gauge bar — fraction of bar_max rendered with heat-scale fill.

    The view has a subtle gray track with a rounded-rect colored fill
    scaled to `fraction` (0.0–1.0). Color interpolates blue→orange→red."""

    def initWithFrame_(self, frame):  # noqa: N802
        self = objc.super(HeatGaugeView, self).initWithFrame_(frame)
        if self is None:
            return None
        self._fraction: float = 0.0
        return self

    def setFraction_(self, fraction):  # noqa: N802
        """Update the fill fraction with a short ease-out animation (Phase 5)."""
        new_fraction = max(0.0, min(1.0, float(fraction)))
        if abs(new_fraction - self._fraction) < 0.001:
            return  # skip animation for negligible changes
        self._fraction = new_fraction
        # Wrap the redraw in a 0.25s ease-out animation context so AppKit
        # smooths any layer-backed transitions during the repaint.
        def _do_draw():
            self.setNeedsDisplay_(True)
        try:
            NSAnimationContext.runAnimationGroup_completionHandler_(
                lambda ctx: (
                    ctx.setDuration_(0.25),
                ),
                _do_draw,
            )
        except Exception:
            self.setNeedsDisplay_(True)

    def drawRect_(self, dirty_rect):  # noqa: N802
        bounds = self.bounds()
        w = bounds.size.width
        h = bounds.size.height
        radius = 2.0

        # Gray track.
        track_color = NSColor.tertiaryLabelColor().colorWithAlphaComponent_(0.2)
        track_path = NSBezierPath.bezierPathWithRoundedRect_xRadius_yRadius_(
            bounds, radius, radius
        )
        track_color.setFill()
        track_path.fill()

        # Colored fill.
        fill_w = max(0.0, self._fraction * w)
        if fill_w > 0:
            fill_rect = NSMakeRect(0.0, 0.0, fill_w, h)
            # Clip to rounded track.
            clip_path = NSBezierPath.bezierPathWithRoundedRect_xRadius_yRadius_(
                bounds, radius, radius
            )
            clip_path.addClip()
            fill_color = _heat_color(self._fraction)
            fill_color.setFill()
            NSBezierPath.fillRect_(fill_rect)


# --- RichRowView ---

# Fixed column widths (pts) — keep columns aligned across all rows.
_COL_SEV_W = 16.0     # severity glyph image view width
_COL_ICON_W = 20.0    # process icon image view width
_COL_NAME_W = 150.0   # process name label
_COL_SPARK_W = 80.0   # sparkline
_COL_GAUGE_W = 60.0   # heat gauge
_COL_CPU_W = 52.0     # CPU% label
_ROW_H = 24.0         # row height
_ROW_PAD_H = 4.0      # top/bottom internal padding (gives 16 pt inner height)
_COL_SPACING = 5.0    # gap between columns


class RichRowView(NSView):
    """Composite NSView row: severity glyph | process icon | name label |
    sparkline | heat gauge | CPU% label.

    Created once per row slot; updated in place per tick via update_().
    Carries the per-row PID/name and builds the context menu on right-click.

    Phase 5: hover state — mouseEntered_ sets an accent-color tint background;
    mouseExited_ restores transparent background. NSTrackingArea installed in
    viewDidMoveToWindow / updateTrackingAreas."""

    def initWithFrame_(self, frame):  # noqa: N802
        self = objc.super(RichRowView, self).initWithFrame_(frame)
        if self is None:
            return None
        self._pid: Optional[int] = None
        self._name: str = ""
        self._app = None
        self._tracking_area = None
        self._hovered: bool = False
        self.setWantsLayer_(True)
        self._build_subviews()
        return self

    def intrinsicContentSize(self):  # noqa: N802
        # NSStackView uses Auto Layout and ignores our manual frame — without
        # an intrinsicContentSize override, rows collapse to zero height and
        # pile up at the bottom of the scroll view. The stack view's leading
        # alignment + this size combine to give each row its fixed footprint.
        total_w = (
            _COL_SPACING
            + _COL_SEV_W + _COL_SPACING
            + _COL_ICON_W + _COL_SPACING
            + _COL_NAME_W + _COL_SPACING
            + _COL_SPARK_W + _COL_SPACING
            + _COL_GAUGE_W + _COL_SPACING
            + _COL_CPU_W + _COL_SPACING
        )
        return NSMakeSize(total_w, _ROW_H)

    def viewDidMoveToWindow(self):  # noqa: N802
        """Install the tracking area whenever we're added to a window."""
        objc.super(RichRowView, self).viewDidMoveToWindow()
        self.updateTrackingAreas()

    def updateTrackingAreas(self):  # noqa: N802
        """Replace the old tracking area with a fresh one sized to bounds."""
        objc.super(RichRowView, self).updateTrackingAreas()
        if self._tracking_area is not None:
            self.removeTrackingArea_(self._tracking_area)
            self._tracking_area = None
        opts = (
            NSTrackingMouseEnteredAndExited
            | NSTrackingActiveInKeyWindow
            | NSTrackingInVisibleRect
        )
        ta = NSTrackingArea.alloc().initWithRect_options_owner_userInfo_(
            self.bounds(), opts, self, None
        )
        self.addTrackingArea_(ta)
        self._tracking_area = ta

    def mouseEntered_(self, event):  # noqa: N802
        self._hovered = True
        accent = NSColor.controlAccentColor().colorWithAlphaComponent_(0.12)
        self.layer().setBackgroundColor_(accent.CGColor())

    def mouseExited_(self, event):  # noqa: N802
        self._hovered = False
        self.layer().setBackgroundColor_(None)

    def _build_subviews(self):
        """Construct all subviews and position them with fixed frames.
        We use manual frame layout (no Auto Layout) because every column
        has a known fixed width — this avoids constraint churn on every tick."""
        h = _ROW_H
        inner_h = h - 2 * _ROW_PAD_H
        y = _ROW_PAD_H  # baseline for inner content

        x = _COL_SPACING

        # 1. Severity glyph image view.
        sev_frame = NSMakeRect(x, (h - inner_h) / 2.0, _COL_SEV_W, inner_h)
        self._sev_view = NSImageView.alloc().initWithFrame_(sev_frame)
        self._sev_view.setImageScaling_(NSImageScaleProportionallyDown)
        self.addSubview_(self._sev_view)
        x += _COL_SEV_W + _COL_SPACING

        # 2. Process icon image view.
        icon_frame = NSMakeRect(x, (h - inner_h) / 2.0, _COL_ICON_W, inner_h)
        self._icon_view = NSImageView.alloc().initWithFrame_(icon_frame)
        self._icon_view.setImageScaling_(NSImageScaleProportionallyDown)
        self.addSubview_(self._icon_view)
        x += _COL_ICON_W + _COL_SPACING

        # 3. Process name label.
        name_frame = NSMakeRect(x, y, _COL_NAME_W, inner_h)
        self._name_field = NSTextField.alloc().initWithFrame_(name_frame)
        self._name_field.setBezeled_(False)
        self._name_field.setDrawsBackground_(False)
        self._name_field.setEditable_(False)
        self._name_field.setSelectable_(False)
        self._name_field.setFont_(
            NSFont.systemFontOfSize_weight_(12.0, NSFontWeightMedium)
        )
        self._name_field.setLineBreakMode_(4)  # NSLineBreakByTruncatingTail = 4
        self._name_field.setStringValue_("")
        self.addSubview_(self._name_field)
        x += _COL_NAME_W + _COL_SPACING

        # 4. Sparkline.
        spark_frame = NSMakeRect(x, y, _COL_SPARK_W, inner_h)
        self._spark_view = SparklineView.alloc().initWithFrame_(spark_frame)
        self.addSubview_(self._spark_view)
        x += _COL_SPARK_W + _COL_SPACING

        # 5. Heat gauge.
        gauge_h = 8.0
        gauge_frame = NSMakeRect(
            x, y + (inner_h - gauge_h) / 2.0, _COL_GAUGE_W, gauge_h
        )
        self._gauge_view = HeatGaugeView.alloc().initWithFrame_(gauge_frame)
        self.addSubview_(self._gauge_view)
        x += _COL_GAUGE_W + _COL_SPACING

        # 6. CPU% label (right-aligned, fixed width).
        cpu_frame = NSMakeRect(x, y, _COL_CPU_W, inner_h)
        self._cpu_field = NSTextField.alloc().initWithFrame_(cpu_frame)
        self._cpu_field.setBezeled_(False)
        self._cpu_field.setDrawsBackground_(False)
        self._cpu_field.setEditable_(False)
        self._cpu_field.setSelectable_(False)
        self._cpu_field.setFont_(NSFont.systemFontOfSize_(11.0))
        self._cpu_field.setAlignment_(2)  # NSTextAlignmentRight = 2
        self._cpu_field.setStringValue_("")
        self.addSubview_(self._cpu_field)

    def setApp_(self, app):  # noqa: N802
        self._app = app

    def apply_update(self, row_data, bar_context, pid_history, pid_severity):
        """Mutate all subviews to reflect new row data.

        row_data   — 7-tuple (forks_n, threads_n, pid, pcpu, stat, name, acc_cpu)
        bar_context — {bar_max, name_width}
        pid_history — dict[pid, deque[(ts, forks_n)]]  (from app.pid_history)
        pid_severity — dict[pid, str]  (from app.pid_severity)
        """
        forks_n, threads_n, pid, pcpu, stat, name, acc_cpu = row_data
        bar_max = bar_context["bar_max"]
        severity = pid_severity.get(pid, "cold")

        # Update per-row identity for context menu.
        old_pid = self._pid
        self._pid = pid
        self._name = name

        # 1. Severity glyph — rebuild if severity changed.
        sev_img = _make_severity_image(severity)
        self._sev_view.setImage_(sev_img)

        # 2. Process icon — only resolve/update when PID changes.
        if pid != old_pid:
            icon = _resolve_pid_icon(pid)
            self._icon_view.setImage_(icon)

        # 3. Name label.
        self._name_field.setStringValue_(name)

        # 4. Sparkline — pass last N samples from pid_history.
        hist = pid_history.get(pid, [])
        self._spark_view.setSamples_severity_(list(hist), severity)

        # 5. Heat gauge — log-scaled fraction matching bar() logic.
        import math
        bar_value = acc_cpu if (self._app is not None and self._app.sort_by == "cpu") else float(forks_n)
        if bar_max > 0 and bar_value > 0:
            fraction = math.log10(bar_value + 1) / math.log10(bar_max + 1)
            fraction = max(0.0, min(1.0, fraction))
        else:
            fraction = 0.0
        self._gauge_view.setFraction_(fraction)

        # 6. CPU% label.
        self._cpu_field.setStringValue_(f"{acc_cpu:.1f}%")

    # ----- right-click context menu -----

    def menuForEvent_(self, _event):  # noqa: N802
        if self._app is None or self._pid is None:
            return None
        return self._app._build_row_context_menu(self._pid, self._name)


_STAT_PRIMARY = {
    "I": "Idle",
    "R": "Running",
    "S": "Sleeping",
    "T": "Stopped",
    "U": "Uninterruptible wait",
    "Z": "Zombie",
}
_STAT_MODIFIER = {
    "+": "foreground",
    "<": "high priority",
    ">": "low priority",
    "E": "exiting",
    "L": "pages locked",
    "N": "niced",
    "s": "session leader",
    "W": "swapped",
    "X": "traced",
}


def decode_stat(stat: str) -> str:
    """Translate a BSD-style ps STAT string (e.g. `Ss`, `S+`, `S<s`) into
    human-readable form: primary state, then comma-separated modifiers."""
    if not stat:
        return ""
    primary = _STAT_PRIMARY.get(stat[0], stat[0])
    mods = [_STAT_MODIFIER[c] for c in stat[1:] if c in _STAT_MODIFIER]
    if not mods:
        return primary
    return f"{primary}, {', '.join(mods)}"


def fmt_name(name: str, width: int = 24) -> str:
    if len(name) <= width:
        return name.ljust(width)
    return name[: width - 1] + "..."


def compute_accumulated_pcpu(procs: list[dict]) -> dict[int, float]:
    """Subtree-accumulated CPU% per PID — each process's own pcpu plus
    the recursive sum of all descendants. Computed iteratively (no
    recursion) so deep trees can't blow the stack.

    The root's accumulated value approaches the menubar's total CPU
    figure by construction: launchd (PID 1) is the ancestor of every
    other user process on macOS, so its subtree sum ≈ Σ all pcpu."""
    children: dict[int, list[int]] = defaultdict(list)
    self_pcpu: dict[int, float] = {}
    for row in procs:
        self_pcpu[row["pid"]] = parse_pcpu(row["pcpu"])
        children[row["ppid"]].append(row["pid"])

    # Top-down traversal from roots (PIDs whose ppid isn't in the snap).
    pid_set = set(self_pcpu.keys())
    roots = [row["pid"] for row in procs if row["ppid"] not in pid_set]
    order: list[int] = []
    stack = list(roots)
    while stack:
        pid = stack.pop()
        order.append(pid)
        stack.extend(children.get(pid, ()))

    # Bottom-up accumulation — children feed parents.
    acc = dict(self_pcpu)
    for pid in reversed(order):
        for child in children.get(pid, ()):
            acc[pid] = acc.get(pid, 0.0) + acc.get(child, 0.0)
    return acc


# --- settings persistence ---

def load_settings() -> dict:
    """Read user settings from disk. Missing/corrupt file → empty dict
    (caller falls back to defaults)."""
    try:
        with open(SETTINGS_PATH) as f:
            data = json.load(f)
        if isinstance(data, dict):
            log.info("settings loaded: %s", data)
            return data
    except FileNotFoundError:
        log.info("settings: no file yet at %s", SETTINGS_PATH)
    except (OSError, json.JSONDecodeError) as e:
        log.error("settings load failed: %s", e)
    return {}


def save_settings(data: dict) -> None:
    """Atomic write to ~/Library/Application Support/watch-forks-menubar/
    settings.json — tempfile + rename so a crashed write can't truncate
    the existing file."""
    try:
        SETTINGS_DIR.mkdir(parents=True, exist_ok=True)
        tmp = SETTINGS_PATH.with_suffix(".tmp")
        with open(tmp, "w") as f:
            json.dump(data, f, indent=2)
        tmp.replace(SETTINGS_PATH)
        log.info("settings saved: %s", data)
    except OSError as e:
        log.error("settings save failed: %s", e)


# --- timer driver (NSTimer in NSRunLoopCommonModes) ---

class _TickHandler(NSObject):
    """Lightweight NSObject so we can target/selector an NSTimer at a
    Python method. Required because NSTimer needs an Objective-C target;
    rumps' built-in Timer doesn't expose hooks for the run-loop mode."""

    def initWithApp_(self, app):
        self = objc.super(_TickHandler, self).init()
        if self is None:
            return None
        self.app = app
        return self

    def fire_(self, _timer):  # noqa: N802 — ObjC selector naming
        try:
            self.app._tick()
        except Exception:  # don't let a transient error kill the timer
            log.exception("tick failed")


# ===========================================================================
# Phase 4 — Header sparkline views
# ===========================================================================
#
# HeaderOverviewView is a plain NSView container that holds three
# SparklinePanelView instances in a horizontal NSStackView. Each panel
# shows a title caption, a large current-value label, a severity glyph,
# and a NSBezierPath sparkline for the last 30 s of data.
#
# SparklinePanelView subclasses NSView and overrides drawRect_ to paint
# the sparkline using NSBezierPath (anti-aliased, 1.5pt stroke, 20%-alpha
# fill under the curve). The big-number label, caption, and glyph are
# NSTextField / NSImageView subviews so Auto Layout handles positioning;
# only the sparkline itself is custom-drawn.

# Severity → NSColor mapping used by both the trend arrow and the
# sparkline stroke.
def _severity_color(severity: str) -> "NSColor":
    if severity == "hot":
        return NSColor.systemRedColor()
    if severity == "warm":
        return NSColor.systemOrangeColor()
    return NSColor.systemBlueColor()


def _trend_color(cpu_trend: str) -> "NSColor":
    if cpu_trend == "rising":
        return NSColor.systemRedColor()
    if cpu_trend == "falling":
        return NSColor.systemBlueColor()
    return NSColor.secondaryLabelColor()


def _severity_symbol(severity: str) -> str:
    """SF Symbol name for the current severity state."""
    if severity == "hot":
        return "flame.fill"
    if severity == "warm":
        return "thermometer.medium"
    return "snowflake"


def _make_label(text: str, font: "NSFont", color: "NSColor" = None) -> "NSTextField":
    tf = NSTextField.alloc().init()
    tf.setBezeled_(False)
    tf.setDrawsBackground_(False)
    tf.setEditable_(False)
    tf.setSelectable_(False)
    tf.setFont_(font)
    tf.setStringValue_(text)
    if color is not None:
        tf.setTextColor_(color)
    tf.setTranslatesAutoresizingMaskIntoConstraints_(False)
    return tf


class SparklinePanelView(NSView):
    """A single sparkline panel: caption + big value + glyph + sparkline.

    Layout (top → bottom):
      • caption label (10pt, secondaryLabelColor)      ~14pt tall
      • value row: big label (22pt semibold) + glyph    ~30pt tall
      • sparkline                                        ~36pt tall

    Total panel height: ~80pt. Width: fills equally inside HeaderOverviewView.

    Data is pushed via _update() — called on every tick from
    _update_header_view, never triggers a re-layout (just redraws).
    """

    def initWithFrame_(self, frame):  # noqa: N802
        self = objc.super(SparklinePanelView, self).initWithFrame_(frame)
        if self is None:
            return None
        self._history: list[float] = []        # the values to plot
        self._stroke_color = NSColor.systemBlueColor()
        self._setup_subviews()
        return self

    def _setup_subviews(self):
        _caption_font = NSFont.systemFontOfSize_weight_(10.0, 0)
        _value_font = NSFont.systemFontOfSize_weight_(22.0, NSFontWeightSemibold)

        self._caption_label = _make_label(
            "", _caption_font, NSColor.secondaryLabelColor()
        )
        self._value_label = _make_label(
            "—", _value_font
        )
        self._glyph_view = NSImageView.alloc().init()
        self._glyph_view.setTranslatesAutoresizingMaskIntoConstraints_(False)

        # Row stack: value label + glyph side by side
        value_row = NSStackView.alloc().init()
        value_row.setOrientation_(NSUserInterfaceLayoutOrientationHorizontal)
        value_row.setSpacing_(4.0)
        value_row.setDistribution_(NSStackViewDistributionFill)
        value_row.setAlignment_(NSLayoutAttributeBottom)
        value_row.setTranslatesAutoresizingMaskIntoConstraints_(False)
        value_row.addView_inGravity_(self._value_label, NSStackViewGravityLeading)
        value_row.addView_inGravity_(self._glyph_view, NSStackViewGravityLeading)
        # Pin the value label width so per-tick text changes (e.g. "1234%"
        # vs "98%" vs "+12.3/s") don't shuffle the intrinsic content size
        # and trigger a stack-view relayout on the entire header — the
        # visible "shutter" on every refresh.
        self._value_label.widthAnchor().constraintEqualToConstant_(100.0).setActive_(True)

        # Outer vertical stack: caption → value_row (sparkline drawn in drawRect_)
        outer = NSStackView.alloc().init()
        outer.setOrientation_(NSUserInterfaceLayoutOrientationVertical)
        outer.setSpacing_(2.0)
        outer.setDistribution_(NSStackViewDistributionFill)
        outer.setAlignment_(NSLayoutAttributeLeading)
        outer.setTranslatesAutoresizingMaskIntoConstraints_(False)
        outer.addView_inGravity_(self._caption_label, NSStackViewGravityTop)
        outer.addView_inGravity_(value_row, NSStackViewGravityTop)

        self.addSubview_(outer)

        # Pin outer stack to top/leading/trailing, leave bottom ~36pt for sparkline
        outer.topAnchor().constraintEqualToAnchor_constant_(self.topAnchor(), 6.0).setActive_(True)
        outer.leadingAnchor().constraintEqualToAnchor_constant_(self.leadingAnchor(), 8.0).setActive_(True)
        outer.trailingAnchor().constraintEqualToAnchor_constant_(self.trailingAnchor(), -8.0).setActive_(True)

        # Glyph size: 18×18pt
        self._glyph_view.widthAnchor().constraintEqualToConstant_(18.0).setActive_(True)
        self._glyph_view.heightAnchor().constraintEqualToConstant_(18.0).setActive_(True)

    def apply_update(
        self,
        caption: str,
        value_text: str,
        history: list,
        stroke_color: "NSColor",
        symbol_name: str = None,
        symbol_color: "NSColor" = None,
    ) -> None:
        """Push new data into the panel and schedule a redraw."""
        self._caption_label.setStringValue_(caption)
        self._value_label.setStringValue_(value_text)
        self._history = list(history)
        self._stroke_color = stroke_color

        # SF Symbol glyph
        if symbol_name:
            try:
                cfg = NSImageSymbolConfiguration.configurationWithHierarchicalColor_(
                    symbol_color or stroke_color
                )
                img = NSImage.imageWithSystemSymbolName_accessibilityDescription_(
                    symbol_name, None
                )
                if img is not None:
                    img = img.imageWithSymbolConfiguration_(cfg)
                    self._glyph_view.setImage_(img)
            except Exception:
                pass
        else:
            self._glyph_view.setImage_(None)

        self.setNeedsDisplay_(True)

    def drawRect_(self, rect):  # noqa: N802
        """Draw the sparkline in the bottom ~36pt of the panel."""
        objc.super(SparklinePanelView, self).drawRect_(rect)

        bounds = self.bounds()
        panel_w = bounds.size.width
        panel_h = bounds.size.height

        # Sparkline occupies the bottom 36pt of the panel
        sparkline_h = 36.0
        sparkline_y = 4.0
        sparkline_x = 8.0
        sparkline_w = panel_w - 16.0

        history = self._history
        n = len(history)
        if n < 2 or sparkline_w <= 0:
            return

        min_val = min(history)
        max_val = max(history)
        val_range = max_val - min_val
        if val_range < 1e-6:
            val_range = 1.0  # flat line — draw at midpoint

        def _x(i):
            return sparkline_x + (i / (n - 1)) * sparkline_w

        def _y(v):
            norm = (v - min_val) / val_range
            # Clamp to [0.05, 0.95] so the line doesn't touch the edges
            norm = max(0.05, min(0.95, norm))
            return sparkline_y + norm * sparkline_h

        # Build the path
        path = NSBezierPath.bezierPath()
        path.setLineWidth_(1.5)
        path.moveToPoint_((NSPoint(_x(0), _y(history[0]))))
        for i in range(1, n):
            path.lineToPoint_((NSPoint(_x(i), _y(history[i]))))

        # Fill area under the curve at 20% alpha
        fill_path = NSBezierPath.bezierPath()
        fill_path.moveToPoint_((NSPoint(_x(0), sparkline_y)))
        fill_path.lineToPoint_((NSPoint(_x(0), _y(history[0]))))
        for i in range(1, n):
            fill_path.lineToPoint_((NSPoint(_x(i), _y(history[i]))))
        fill_path.lineToPoint_((NSPoint(_x(n - 1), sparkline_y)))
        fill_path.closePath()

        fill_color = self._stroke_color.colorWithAlphaComponent_(0.18)
        fill_color.setFill()
        fill_path.fill()

        # Stroke
        self._stroke_color.setStroke()
        NSGraphicsContext.currentContext().setShouldAntialias_(True)
        path.stroke()


class HeaderOverviewView(NSView):
    """Three-panel sparkline header: CPU · PROCS · RATE.

    Constructed once by _create_header_view; mutated in place by
    _update_header_view on every tick. Width matches the popover
    (~460pt); height is fixed at 92pt.
    """

    HEADER_HEIGHT = 92.0

    def initWithFrame_(self, frame):  # noqa: N802
        self = objc.super(HeaderOverviewView, self).initWithFrame_(frame)
        if self is None:
            return None
        self._setup_panels()
        return self

    def _setup_panels(self):
        self._cpu_panel = SparklinePanelView.alloc().initWithFrame_(
            NSMakeRect(0, 0, 140, self.HEADER_HEIGHT)
        )
        self._procs_panel = SparklinePanelView.alloc().initWithFrame_(
            NSMakeRect(0, 0, 140, self.HEADER_HEIGHT)
        )
        self._rate_panel = SparklinePanelView.alloc().initWithFrame_(
            NSMakeRect(0, 0, 140, self.HEADER_HEIGHT)
        )

        hstack = NSStackView.alloc().init()
        hstack.setOrientation_(NSUserInterfaceLayoutOrientationHorizontal)
        hstack.setDistribution_(NSStackViewDistributionFillEqually)
        hstack.setSpacing_(0.0)
        hstack.setTranslatesAutoresizingMaskIntoConstraints_(False)
        hstack.addView_inGravity_(self._cpu_panel, NSStackViewGravityLeading)
        hstack.addView_inGravity_(self._procs_panel, NSStackViewGravityLeading)
        hstack.addView_inGravity_(self._rate_panel, NSStackViewGravityLeading)

        self.addSubview_(hstack)
        hstack.topAnchor().constraintEqualToAnchor_(self.topAnchor()).setActive_(True)
        hstack.leadingAnchor().constraintEqualToAnchor_(self.leadingAnchor()).setActive_(True)
        hstack.trailingAnchor().constraintEqualToAnchor_(self.trailingAnchor()).setActive_(True)
        hstack.bottomAnchor().constraintEqualToAnchor_(self.bottomAnchor()).setActive_(True)

    def update_data(self, global_state: dict) -> None:
        """Push fresh tick data into the three sparkline panels."""
        cpu_history = global_state.get("cpu_history", [])
        proc_history = global_state.get("proc_history", [])
        severity = global_state.get("severity", "cold")
        cpu_trend = global_state.get("cpu_trend", "steady")
        total_cpu = global_state.get("total_cpu", 0.0)
        total_procs = global_state.get("total_procs", 0)
        rate = global_state.get("rate", 0.0)

        sev_color = _severity_color(severity)
        trend_color = _trend_color(cpu_trend)
        trend_arrow = TREND_BY_STATE.get(cpu_trend, "→")

        # --- CPU panel ---
        cpu_vals = [v for _, v in cpu_history] if cpu_history else [total_cpu]
        self._cpu_panel.apply_update(
            caption="CPU",
            value_text=f"{total_cpu:.0f}% {trend_arrow}",
            history=cpu_vals,
            stroke_color=trend_color,
            symbol_name=None,
        )
        # Tint the value label with the trend color
        self._cpu_panel._value_label.setTextColor_(trend_color)

        # --- PROCS panel ---
        proc_vals = [float(v) for _, v in proc_history] if proc_history else [float(total_procs)]
        self._procs_panel.apply_update(
            caption="PROCS",
            value_text=str(total_procs),
            history=proc_vals,
            stroke_color=sev_color,
            symbol_name=_severity_symbol(severity),
            symbol_color=sev_color,
        )
        self._procs_panel._value_label.setTextColor_(NSColor.labelColor())

        # --- RATE panel ---
        # Derive per-sample rate from proc_history (differential of adjacent points)
        rate_vals: list[float] = []
        if len(proc_history) >= 2:
            pts = list(proc_history)
            # Take up to the last 16 points
            pts = pts[-16:]
            for j in range(1, len(pts)):
                t0, n0 = pts[j - 1]
                t1, n1 = pts[j]
                dt = t1 - t0
                rate_vals.append((n1 - n0) / dt if dt > 0 else 0.0)
        if not rate_vals:
            rate_vals = [rate]

        rate_color = _severity_color(severity)
        self._rate_panel.apply_update(
            caption="RATE",
            value_text=f"{rate:+.1f}/s",
            history=rate_vals,
            stroke_color=rate_color,
            symbol_name=None,
        )
        rate_label_color = NSColor.systemRedColor() if rate > 0 else (
            NSColor.systemBlueColor() if rate < 0 else NSColor.secondaryLabelColor()
        )
        self._rate_panel._value_label.setTextColor_(rate_label_color)


# ===========================================================================
# Popover view controller
# ===========================================================================
#
# WatchForksViewController hosts the popover's content. It owns the view
# hierarchy (header + scrollable rows + footer) and exposes the two
# create/update override points that Phases 3 and 4 will replace:
#
#   _create_row_view(row_data, bar_context) → NSView
#   _update_row_view(view, row_data, bar_context) → None
#   _create_header_view(launchd_data, global_state) → NSView
#   _update_header_view(view, launchd_data, global_state) → None
#
# Phase 4 swapped _create_header_view / _update_header_view to return /
# mutate a HeaderOverviewView (three SparklinePanelView panels: CPU, PROCS,
# RATE). Phase 3 will replace _create_row_view with a rich composite view.
# The data plumbing stays the same — only the view construction/update logic
# changes.

class WatchForksViewController(NSViewController):
    """NSViewController that owns the popover's view hierarchy.

    Built lazily by loadView() the first time AppKit needs the view — we
    construct the stack-of-stacks layout once, then mutate text in place
    on each tick. The row views are kept as a Python list (self._row_views)
    so the app can call _update_row_view on each slot per tick; rows
    beyond the current top-N are removed and re-added when top-N changes.
    """

    # NSViewController.alloc().init() invokes initWithNibName_bundle_(None, None);
    # we set the back-pointer to the app afterwards via setApp_.

    def setApp_(self, app):  # noqa: N802
        """Back-pointer so callbacks (footer buttons, row context menus)
        can reach the app's state and methods. Set immediately after init."""
        self._app = app
        self._row_views: list[NSTextField] = []
        self._header_view = None
        self._row_stack = None
        self._scroll_view = None
        self._scroll_height_constraint = None
        self._settings_menu = None

    # ----- view construction (called once by AppKit) -----

    def loadView(self):  # noqa: N802 — ObjC selector
        """Build the popover's content view: a vertical NSStackView with
        header, separator, scrollable row region, separator, footer. The
        view is sized to POPOVER_WIDTH × (header + rows + footer); the
        scroll view caps its content at POPOVER_ROW_AREA_HEIGHT."""
        # Root vertical stack — fills the popover.
        root = NSStackView.alloc().init()
        root.setOrientation_(NSUserInterfaceLayoutOrientationVertical)
        root.setAlignment_(NSLayoutAttributeLeading)
        root.setSpacing_(6.0)
        root.setEdgeInsets_((10.0, 10.0, 10.0, 10.0))
        root.setDistribution_(NSStackViewDistributionFill)
        root.setTranslatesAutoresizingMaskIntoConstraints_(False)

        # Header — Phase 4 multi-sparkline overview view.
        header = self._app._create_header_view(
            self._initial_header_data(), self._initial_global_state()
        )
        self._header_view = header
        # Fix the header height so the popover doesn't collapse it.
        header.heightAnchor().constraintEqualToConstant_(
            HeaderOverviewView.HEADER_HEIGHT
        ).setActive_(True)
        root.addView_inGravity_(header, NSStackViewGravityTop)

        # Separator
        sep1 = NSBox.alloc().init()
        sep1.setBoxType_(NSBoxSeparator)
        root.addView_inGravity_(sep1, NSStackViewGravityTop)

        # Scrollable rows region — inner stack of row views, wrapped in
        # an NSScrollView so the popover stays a fixed height even when
        # top-N grows.
        row_stack = NSStackView.alloc().init()
        row_stack.setOrientation_(NSUserInterfaceLayoutOrientationVertical)
        row_stack.setAlignment_(NSLayoutAttributeLeading)
        row_stack.setSpacing_(2.0)
        row_stack.setDistribution_(NSStackViewDistributionFill)
        row_stack.setTranslatesAutoresizingMaskIntoConstraints_(False)
        self._row_stack = row_stack

        scroll = NSScrollView.alloc().init()
        scroll.setHasVerticalScroller_(True)
        scroll.setHasHorizontalScroller_(False)
        # Force overlay scroller style — legacy scrollers reserve width and
        # appear/disappear as content height fluctuates, producing a 1-2px
        # horizontal "shutter" on every refresh. Overlay scrollers overlay
        # the content with no layout impact.
        scroll.setScrollerStyle_(NSScrollerStyleOverlay)
        scroll.setBorderType_(0)  # NSNoBorder
        scroll.setDrawsBackground_(False)
        scroll.setDocumentView_(row_stack)
        scroll.setTranslatesAutoresizingMaskIntoConstraints_(False)
        # Width fixed; height starts at the cap but is resized dynamically
        # by _apply_layout_for_row_count when the row count changes, so the
        # popover snaps to fit content when there are fewer than max rows.
        self._scroll_height_constraint = scroll.heightAnchor().constraintEqualToConstant_(
            POPOVER_ROW_AREA_HEIGHT
        )
        self._scroll_height_constraint.setActive_(True)
        scroll.widthAnchor().constraintEqualToConstant_(
            POPOVER_WIDTH - 20.0
        ).setActive_(True)
        # Pin the inner stack's width to the scroll view's clip view width
        # so row views don't get squeezed when the doc view is narrower.
        row_stack.widthAnchor().constraintEqualToAnchor_(
            scroll.contentView().widthAnchor()
        ).setActive_(True)
        self._scroll_view = scroll
        root.addView_inGravity_(scroll, NSStackViewGravityTop)

        # Separator
        sep2 = NSBox.alloc().init()
        sep2.setBoxType_(NSBoxSeparator)
        root.addView_inGravity_(sep2, NSStackViewGravityTop)

        # Footer — Settings ▾ (NSMenu popup), Refresh, Open in Terminal, Quit.
        footer = self._build_footer()
        root.addView_inGravity_(footer, NSStackViewGravityTop)

        # Width constraint on root so loadView's view has a defined size
        # before NSPopover queries -contentSize.
        root.widthAnchor().constraintEqualToConstant_(POPOVER_WIDTH).setActive_(True)

        self.setView_(root)

    def _initial_header_data(self) -> Optional[tuple]:
        """Header data tuple at initial construction time. The app's
        _tick() may not have run yet, so we hand back a placeholder
        that _create_header_view can render as an em-dash banner."""
        return None  # _create_header_view handles None as "no data yet"

    def _initial_global_state(self) -> dict:
        """Minimal global_state dict for header construction before any tick
        has run. All values are neutral defaults — the header panels will show
        '—' / 0 until the first tick populates real data."""
        app = self._app
        return {
            "severity": getattr(app, "severity", "cold"),
            "rate": getattr(app, "rate", 0.0),
            "cpu_trend": getattr(app, "cpu_trend", "steady"),
            "proc_history": list(getattr(app, "proc_history", [])),
            "cpu_history": list(getattr(app, "cpu_history", [])),
            "total_cpu": 0.0,
            "total_procs": 0,
        }

    # ----- footer construction -----

    def _build_footer(self):
        """Horizontal NSStackView holding the footer controls. Settings
        is a button that pops up an NSMenu (the rumps-style submenus for
        Interval / Top N / Sort by / Start at login live there); the
        other footer slots are plain action buttons."""
        footer = NSStackView.alloc().init()
        footer.setOrientation_(NSUserInterfaceLayoutOrientationHorizontal)
        footer.setSpacing_(8.0)
        footer.setDistribution_(NSStackViewDistributionFill)
        footer.setAlignment_(NSLayoutAttributeBottom)

        settings_btn = NSButton.alloc().init()
        settings_btn.setTitle_("Settings ▾")
        settings_btn.setBezelStyle_(NSBezelStyleRounded)
        settings_btn.setTarget_(self)
        settings_btn.setAction_(b"showSettings:")
        footer.addView_inGravity_(settings_btn, NSStackViewGravityLeading)

        refresh_btn = NSButton.alloc().init()
        refresh_btn.setTitle_("Refresh")
        refresh_btn.setBezelStyle_(NSBezelStyleRounded)
        refresh_btn.setTarget_(self)
        refresh_btn.setAction_(b"refreshNow:")
        footer.addView_inGravity_(refresh_btn, NSStackViewGravityLeading)

        terminal_btn = NSButton.alloc().init()
        terminal_btn.setTitle_("Open in Terminal…")
        terminal_btn.setBezelStyle_(NSBezelStyleRounded)
        terminal_btn.setTarget_(self)
        terminal_btn.setAction_(b"openTerminal:")
        footer.addView_inGravity_(terminal_btn, NSStackViewGravityLeading)

        # Spacer — pushes Quit to the right.
        spacer = NSStackView.alloc().init()
        footer.addView_inGravity_(spacer, NSStackViewGravityCenter)

        quit_btn = NSButton.alloc().init()
        quit_btn.setTitle_("Quit")
        quit_btn.setBezelStyle_(NSBezelStyleRounded)
        quit_btn.setTarget_(self)
        quit_btn.setAction_(b"quitApp:")
        footer.addView_inGravity_(quit_btn, NSStackViewGravityTrailing)

        return footer

    # ----- footer button actions (ObjC selectors) -----

    def showSettings_(self, sender):  # noqa: N802
        """Pop up the settings NSMenu under the Settings button.

        We rebuild the menu on each click so the radio-dot state and
        Start-at-login title reflect current values without bookkeeping
        across ticks — the cost is ~1 ms per click, negligible."""
        menu = self._build_settings_menu()
        # Position the menu so its top-left corner anchors at the
        # button's bottom-left — feels like a native popup button.
        loc = NSPoint(0.0, sender.bounds().size.height + 2.0)
        menu.popUpMenuPositioningItem_atLocation_inView_(None, loc, sender)

    def refreshNow_(self, _sender):  # noqa: N802
        self._app._refresh_now(None)

    def openTerminal_(self, _sender):  # noqa: N802
        self._app._open_terminal(None)

    def quitApp_(self, _sender):  # noqa: N802
        rumps.quit_application()

    # ----- settings menu (rebuilt per click) -----

    def _build_settings_menu(self) -> NSMenu:
        """Rebuild the settings NSMenu — Interval / Top N / Sort by
        submenus, Start at login toggle. Radio state is set from the
        app's current settings so the operator sees the live values."""
        app = self._app
        menu = NSMenu.alloc().init()
        menu.setAutoenablesItems_(False)

        # Interval submenu
        interval_menu = NSMenu.alloc().init()
        interval_menu.setAutoenablesItems_(False)
        for sec in INTERVAL_CHOICES:
            label = interval_label(sec)
            it = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_(
                label, b"settingsInterval:", ""
            )
            it.setTarget_(self)
            it.setRepresentedObject_(sec)
            it.setState_(1 if sec == app.interval else 0)
            interval_menu.addItem_(it)
        interval_root = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_(
            "Interval", None, ""
        )
        interval_root.setSubmenu_(interval_menu)
        menu.addItem_(interval_root)

        # Top N submenu
        top_menu = NSMenu.alloc().init()
        top_menu.setAutoenablesItems_(False)
        for n in TOP_CHOICES:
            it = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_(
                f"{n}", b"settingsTop:", ""
            )
            it.setTarget_(self)
            it.setRepresentedObject_(n)
            it.setState_(1 if n == app.top else 0)
            top_menu.addItem_(it)
        top_root = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_(
            "Top N", None, ""
        )
        top_root.setSubmenu_(top_menu)
        menu.addItem_(top_root)

        # Sort by submenu
        sort_menu = NSMenu.alloc().init()
        sort_menu.setAutoenablesItems_(False)
        for key, label in SORT_CHOICES:
            it = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_(
                label, b"settingsSort:", ""
            )
            it.setTarget_(self)
            it.setRepresentedObject_(key)
            it.setState_(1 if key == app.sort_by else 0)
            sort_menu.addItem_(it)
        sort_root = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_(
            "Sort by", None, ""
        )
        sort_root.setSubmenu_(sort_menu)
        menu.addItem_(sort_root)

        menu.addItem_(NSMenuItem.separatorItem())

        # Start-at-login toggle — title flips on each invocation.
        login_title = (
            "Disable start at login" if is_login_enabled() else "Start at login"
        )
        login_item = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_(
            login_title, b"settingsToggleLogin:", ""
        )
        login_item.setTarget_(self)
        menu.addItem_(login_item)

        return menu

    # ----- settings menu actions -----

    def settingsInterval_(self, sender):  # noqa: N802
        sec = sender.representedObject()
        self._app._apply_interval(float(sec))

    def settingsTop_(self, sender):  # noqa: N802
        n = sender.representedObject()
        self._app._apply_top(int(n))

    def settingsSort_(self, sender):  # noqa: N802
        key = sender.representedObject()
        self._app._apply_sort(str(key))

    def settingsToggleLogin_(self, _sender):  # noqa: N802
        self._app._toggle_login(None)

    # ----- row stack management (called by app on every tick) -----

    def syncRowCount_(self, n):  # noqa: N802
        """Grow or shrink self._row_views (and the NSStackView) so it
        holds exactly `n` row views. Existing views are reused — only
        the deltas at the tail are added/removed. Called by the app's
        _tick before per-row updates so the stack matches top-N."""
        current = len(self._row_views)
        if n > current:
            for _ in range(n - current):
                # Build a fresh row view with no data — the app will
                # populate it via _update_row_view immediately after.
                view = self._app._create_row_view(None, None)
                self._row_views.append(view)
                self._row_stack.addView_inGravity_(view, NSStackViewGravityTop)
        elif n < current:
            for view in self._row_views[n:]:
                self._row_stack.removeView_(view)
            del self._row_views[n:]
        if n != current:
            # Only recompute when row count actually changed — avoids
            # per-tick layout churn on a stable top-N.
            self._apply_layout_for_row_count(n)

    def _apply_layout_for_row_count(self, n: int) -> None:
        """Resize the scroll view + popover content size to fit exactly `n`
        rows, capped at POPOVER_ROW_AREA_HEIGHT. When n*row_height < cap,
        the popover snaps to fit content instead of leaving empty space."""
        row_spacing = 2.0  # matches row_stack.setSpacing_(2.0)
        if n <= 0:
            rows_h = 0.0
        else:
            rows_h = n * _ROW_H + (n - 1) * row_spacing
        scroll_h = min(rows_h, POPOVER_ROW_AREA_HEIGHT)
        if self._scroll_height_constraint is not None:
            self._scroll_height_constraint.setConstant_(scroll_h)
        # Header (HEADER_HEIGHT) + sep (~2) + scroll_h + sep (~2) + footer
        # (~32) + 4×6pt root spacing + 2×10pt insets ≈ HEADER + 80 + scroll_h.
        chrome_h = HeaderOverviewView.HEADER_HEIGHT + 80.0
        new_size = NSMakeSize(POPOVER_WIDTH, chrome_h + scroll_h)
        if self._app is not None and self._app._popover is not None:
            self._app._popover.setContentSize_(new_size)


# ===========================================================================
# Row context menu — right-click actions
# ===========================================================================
#
# Per-row actions used to live in NSMenu submenus (Copy PID / Show in Activity
# Monitor / Send SIGTERM / Send SIGKILL). In the popover world these become a
# context menu summoned by right-clicking the row view. To attach a context
# menu to an NSView we need to subclass it and override -menuForEvent: — wrap
# a row view in a "RowContainerView" that holds the per-row PID/name and
# returns the freshly-built menu on demand.
#
# Phase 2 placeholder row view IS a plain NSTextField, not a container — to
# keep the architecture clean for Phase 3 (where the rich row view itself
# will be the container), we make the row view itself responsible for its
# context menu. _PlaceholderRowView is a thin NSTextField subclass that
# carries (pid, name, app_ref) and builds the menu on right-click.


class _PlaceholderRowView(NSTextField):
    """NSTextField row view with right-click context menu. Carries the
    per-row identity so menu actions know which PID to target.

    Phase 3 will replace this with a richer NSView subclass; the
    menuForEvent_ contract carries over verbatim — same per-row identity,
    same menu building, only the rendering changes.
    """

    def initFrame_(self, frame):  # noqa: N802
        self = objc.super(_PlaceholderRowView, self).initWithFrame_(frame)
        if self is None:
            return None
        self._pid: Optional[int] = None
        self._name: str = ""
        self._app = None
        return self

    def setRowApp_pid_name_(self, app, pid, name):  # noqa: N802
        self._app = app
        self._pid = pid
        self._name = name

    def menuForEvent_(self, _event):  # noqa: N802
        if self._app is None or self._pid is None:
            return None
        return self._app._build_row_context_menu(self._pid, self._name)


# ===========================================================================
# Row / header action delegate
# ===========================================================================
#
# NSMenuItem actions need an ObjC target. We could route them straight to the
# app, but the app is a plain Python object (rumps.App is not an NSObject
# subclass in a way AppKit can target). Wrap the per-action callbacks in a
# tiny NSObject so AppKit can invoke them.


class _MenuActionTarget(NSObject):
    """Generic NSObject target for NSMenuItem callbacks. Carries a
    Python callable in representedObject (we use a closure list, since
    representedObject must be ObjC-bridgeable, by indexing into a
    keep-alive dict on the target)."""

    def initWithApp_(self, app):  # noqa: N802
        self = objc.super(_MenuActionTarget, self).init()
        if self is None:
            return None
        self.app = app
        return self

    def invokeCopyPID_(self, sender):  # noqa: N802
        pid = sender.representedObject()
        self.app._make_copy_pid(int(pid))(None)

    def invokeShowActivity_(self, sender):  # noqa: N802
        pid = sender.representedObject()
        self.app._make_show_activity_monitor(int(pid))(None)

    def invokeSIGTERM_(self, sender):  # noqa: N802
        info = sender.representedObject()  # [pid, name]
        pid, name = int(info[0]), str(info[1])
        self.app._make_kill(pid, name, signal.SIGTERM)(None)

    def invokeSIGKILL_(self, sender):  # noqa: N802
        info = sender.representedObject()
        pid, name = int(info[0]), str(info[1])
        self.app._make_kill(pid, name, signal.SIGKILL)(None)


# ===========================================================================
# Status item click target — toggles the popover
# ===========================================================================
#
# rumps installs the NSStatusItem and sets its menu to the rumps NSMenu.
# We override that by setMenu_(None) and binding the button's target/action
# to our togglePopover_ selector — clicking the menu bar item now opens our
# NSPopover instead of dropping rumps's NSMenu.


class _StatusClickTarget(NSObject):
    """NSObject target/action for the status bar button. Toggles the
    popover open/closed and anchors it under the status bar button."""

    def initWithApp_(self, app):  # noqa: N802
        self = objc.super(_StatusClickTarget, self).init()
        if self is None:
            return None
        self.app = app
        return self

    def togglePopover_(self, sender):  # noqa: N802
        try:
            self.app._toggle_popover(sender)
        except Exception:
            log.exception("togglePopover failed")


class _PopoverDelegate(NSObject):
    """NSPopoverDelegate — detachment + post-show scroll reset.

    Detachment: popoverShouldDetach_ returning True lets macOS turn the
    popover into a floating window when dragged.

    Post-show scroll: popoverDidShow_ fires AFTER AppKit's first real
    layout pass, by which time the doc view's frame.height reflects the
    actual row count. Calling scroll-to-top from here catches the
    first-open case where the pre-show scroll ran before layout settled."""

    def initWithApp_(self, app):  # noqa: N802
        self = objc.super(_PopoverDelegate, self).init()
        if self is None:
            return None
        self._app = app
        return self

    def popoverShouldDetach_(self, popover):  # noqa: N802
        return True

    def popoverDidShow_(self, notification):  # noqa: N802
        try:
            self._app._scroll_rows_to_top()
        except Exception:
            log.exception("post-show scroll-to-top failed")


class WatchForksApp(rumps.App):
    def __init__(self) -> None:
        super().__init__("watch-forks", title="…", quit_button=None)
        log.info("=" * 60)
        log.info("watch-forks-menubar starting (pid=%d)", os.getpid())

        # Load persisted settings; coerce values to the offered choice
        # lists so a stale settings file doesn't break the radio state.
        settings = load_settings()
        self.interval = (
            settings.get("interval") if settings.get("interval") in INTERVAL_CHOICES
            else DEFAULT_INTERVAL
        )
        self.top = (
            settings.get("top") if settings.get("top") in TOP_CHOICES else DEFAULT_TOP
        )
        valid_sort_keys = {key for key, _ in SORT_CHOICES}
        self.sort_by = (
            settings.get("sort_by") if settings.get("sort_by") in valid_sort_keys
            else DEFAULT_SORT
        )
        self._last_snapshot: list[tuple[int, int, int, str, str, str, float]] = []
        # Rate-based severity state — sticky across ticks; only changes
        # when the rolling rate crosses a hysteresis threshold.
        self.severity: str = "cold"
        self.rate: float = 0.0
        self.proc_history: deque[tuple[float, int]] = deque()
        # Phase 4: rolling CPU history for the header sparkline.
        self.cpu_history: deque[tuple[float, float]] = deque()
        # Per-PID rate state, same machine. Pruned each tick to whatever
        # PIDs are alive in the current snapshot.
        self.pid_history: dict[int, deque[tuple[float, int]]] = {}
        self.pid_severity: dict[int, str] = {}
        # Signed CPU trend (rising/steady/falling) — current_total_cpu minus
        # prior sample. last_total_cpu seeds at None so the first tick can't
        # synthesize a giant delta against zero.
        self.last_total_cpu: Optional[float] = None
        self.cpu_trend: str = "steady"

        # Bar context cached between snapshot collection and per-row
        # rendering — bar_max + name_width depend on the whole snapshot,
        # but the row view needs them per-row.
        self._bar_context: dict = {"bar_max": 0.0, "name_width": 16}

        # Popover + view controller — built lazily on first toggle so
        # we don't pay the construction cost if the operator never opens
        # the popover, but constructed once and reused thereafter.
        self._popover: Optional[NSPopover] = None
        self._vc: Optional[WatchForksViewController] = None
        self._menu_action_target: Optional[_MenuActionTarget] = None
        self._status_click_target: Optional[_StatusClickTarget] = None

        # Hide rumps's default NSMenu — the status item action is rebound
        # to togglePopover_ in _bind_status_item_to_popover.
        self._bind_status_item_to_popover()

        # Phase 5: observe NSApplicationDidChangeEffectiveAppearanceNotification
        # so custom-drawn views repaint when the user switches light ↔ dark mode.
        self._appearance_observer = None
        self._install_appearance_observer()

        # Initial render BEFORE timer arms — title is non-empty at first display.
        self._tick()

        # NSTimer in common modes — fires during menu / popover tracking too.
        self._tick_handler = _TickHandler.alloc().initWithApp_(self)
        self._ns_timer = None
        self._reschedule_timer()

    # ----- status item binding (replace rumps's NSMenu with togglePopover_) -----

    def _bind_status_item_to_popover(self) -> None:
        """Detach rumps's NSMenu from the status item and route clicks to
        our togglePopover_ instead. The status item itself stays owned by
        rumps (it manages title updates) — we just commandeer the click.

        rumps creates the NSStatusItem inside applicationDidFinishLaunching,
        which fires *after* __init__ returns (the runloop hasn't started
        yet). So we just allocate the click target here; the actual rebind
        happens in _maybe_rebind_status_item, called from _tick — by then
        the runloop is up and the status item exists.
        """
        self._status_click_target = _StatusClickTarget.alloc().initWithApp_(self)

    def _maybe_rebind_status_item(self) -> None:
        """Idempotent: detach rumps's NSMenu and bind click to togglePopover_.

        Called from every _tick — the second-and-later calls are cheap
        because we early-out once the binding is done. We do this from
        _tick so we're guaranteed to be inside the runloop, by which
        time rumps has created the status item."""
        if getattr(self, "_status_bound", False):
            return
        nsapp = getattr(self, "_nsapp", None)
        if nsapp is None:
            return
        item = getattr(nsapp, "nsstatusitem", None)
        if item is None:
            return
        # Disconnect rumps's NSMenu — without this, AppKit routes clicks to
        # popUpMenu before our action fires, and the popover never opens.
        item.setMenu_(None)
        btn = item.button() if hasattr(item, "button") else None
        if btn is None:
            log.warning("status item has no button() — cannot bind popover")
            return
        btn.setTarget_(self._status_click_target)
        btn.setAction_(b"togglePopover:")
        # Pin the status item to a fixed width. Default is NSVariableStatusItemLength
        # (-1) which sizes to the title's current width — and since our title
        # ("❄️ 973 / 178% ↑") shifts by 1-2 pixels as digits change ("4" wider than
        # "1", arrow swaps direction, etc.), the status button reflows every tick.
        # NSPopover anchors to that button and follows the shift → entire popover
        # shudders left/right per refresh. Fixed length kills the anchor jitter.
        item.setLength_(STATUS_ITEM_LENGTH)
        self._status_bound = True
        log.info("status item bound to togglePopover (length=%.0fpt)", STATUS_ITEM_LENGTH)

    # ----- light/dark mode observer (Phase 5) -----

    def _install_appearance_observer(self) -> None:
        """Subscribe to NSApplicationDidChangeEffectiveAppearanceNotification.

        On notification, call setNeedsDisplay_(True) on all custom-drawn
        views in the popover so they repaint with the new effective colors.
        Uses addObserverForName_object_queue_usingBlock_ (block-based API,
        no NSObject subclass required)."""
        nc = NSNotificationCenter.defaultCenter()
        # Keep the observer token so we can remove it if needed.
        self._appearance_observer = nc.addObserverForName_object_queue_usingBlock_(
            "NSApplicationDidChangeEffectiveAppearanceNotification",
            None,
            NSOperationQueue.mainQueue(),
            self._on_appearance_change,
        )

    def _on_appearance_change(self, notification) -> None:
        """Repaint all custom-drawn views when light/dark mode changes."""
        if self._vc is None:
            return
        # Header panels
        header = self._vc._header_view
        if header is not None:
            for panel in (header._cpu_panel, header._procs_panel, header._rate_panel):
                panel.setNeedsDisplay_(True)
        # Row views
        for view in self._vc._row_views:
            if isinstance(view, RichRowView):
                view._spark_view.setNeedsDisplay_(True)
                view._gauge_view.setNeedsDisplay_(True)
                view.setNeedsDisplay_(True)

    # ----- popover lifecycle -----

    def _ensure_popover(self) -> NSPopover:
        """Construct the NSPopover + WatchForksViewController on first
        toggle. Subsequent calls return the cached popover."""
        if self._popover is not None:
            return self._popover
        vc = WatchForksViewController.alloc().init()
        vc.setApp_(self)
        # Force loadView to run by accessing .view() — gives us a chance
        # to populate the initial header/rows before the popover opens.
        _ = vc.view()
        self._vc = vc

        popover = NSPopover.alloc().init()
        popover.setContentViewController_(vc)
        # Phase 5: semitransient behavior allows the user to drag the popover
        # out into a detached floating window; the delegate's
        # popoverShouldDetach_ returning True enables that.
        popover.setBehavior_(NSPopoverBehaviorSemitransient)
        self._popover_delegate = _PopoverDelegate.alloc().initWithApp_(self)
        popover.setDelegate_(self._popover_delegate)
        # Sizing — content view's intrinsic size carries through, but set
        # a reasonable default content size so the popover doesn't open
        # at 0×0 in case auto-layout hasn't computed yet.
        # Computed default size: header + sep + row area + sep + footer + spacing/insets.
        # Layout: 92 (header) + 2 (sep) + 640 (rows) + 2 (sep) + 32 (footer)
        # + 4×6 (spacing) + 2×10 (insets) ≈ 814pt.
        popover.setContentSize_(NSMakeSize(
            POPOVER_WIDTH,
            HeaderOverviewView.HEADER_HEIGHT + POPOVER_ROW_AREA_HEIGHT + 80.0
        ))
        self._popover = popover
        log.info("popover constructed (width=%.0f)", POPOVER_WIDTH)
        return popover

    def _close_popover_if_shown(self) -> None:
        """Dismiss the popover immediately (no animation). Used before any
        modal alert or focus-stealing action — the popover lives at
        NSPopUpMenuWindowLevel and traps modal dialogs underneath it,
        locking the UI. close() returns synchronously; performClose_ runs
        an async close animation that doesn't complete before subprocess
        calls block the main thread, so the popover is still visible when
        the downstream dialog appears."""
        if self._popover is not None and self._popover.isShown():
            self._popover.close()

    def _toggle_popover(self, sender) -> None:
        """Click handler — toggle popover visibility, anchored under the
        status bar button. Re-renders fresh data before opening so the
        popover never flashes stale content from the prior open."""
        popover = self._ensure_popover()
        if popover.isShown():
            popover.performClose_(None)
            return
        # Repopulate before showing so opening the popover always
        # reflects the live snapshot, even between timer ticks.
        try:
            self._tick()
        except Exception:
            log.exception("pre-open tick failed")
        # Reset scroll position to the top of the row list so every open
        # starts at row 1, regardless of where the user left it before close.
        self._scroll_rows_to_top()
        # Activate so the popover gets keyboard focus + comes forward.
        NSApp.activateIgnoringOtherApps_(True)
        popover.showRelativeToRect_ofView_preferredEdge_(
            sender.bounds(), sender, NSRectEdgeMinY,
        )

    def _scroll_rows_to_top(self) -> None:
        """Snap the row scroll view back to the topmost row. macOS NSView's
        default coord origin is bottom-left (not flipped), so 'scroll to top'
        means scroll to y = documentView.height; constrainScrollPoint_ clamps
        to the actual valid range so we don't overshoot.

        Calls layoutSubtreeIfNeeded() first so the doc view's frame.height
        reflects the current row count — on the FIRST popover open, child
        view heights are still being computed and the doc frame is empty
        until layout runs."""
        sv = getattr(self._vc, "_scroll_view", None) if self._vc is not None else None
        if sv is None:
            return
        doc = sv.documentView()
        if doc is None:
            return
        # Force the doc view's auto-layout to settle so frame.height is real.
        doc.layoutSubtreeIfNeeded()
        clip = sv.contentView()
        if doc.isFlipped():
            target = NSMakePoint(0.0, 0.0)
        else:
            target = NSMakePoint(0.0, doc.frame().size.height)
        clip.scrollToPoint_(clip.constrainScrollPoint_(target))
        sv.reflectScrolledClipView_(clip)

    # ----- data collection (delegate to watch-forks) -----

    def _collect(self) -> list[tuple[int, int, int, str, str, str, float]]:
        """Return a sorted snapshot of (forks, threads, pid, pcpu_str, stat,
        name, acc_cpu) per process. acc_cpu is the subtree-accumulated CPU%
        so launchd's row carries the full tree total (matching the menubar).
        Sort key is driven by self.sort_by (forks | cpu)."""
        threads = _wf.collect_threads()
        ucomm = _wf.collect_ucomm()
        procs = _wf.collect_procs()
        tmux_sessions = _wf.collect_tmux_sessions()
        tmux_suffix = f" ({', '.join(tmux_sessions)})" if tmux_sessions else ""
        forks: dict[int, int] = defaultdict(int)
        for row in procs:
            forks[row["ppid"]] += 1
        acc_cpu = compute_accumulated_pcpu(procs)
        out: list[tuple[int, int, int, str, str, str, float]] = []
        for row in procs:
            name = _wf.shortname(row["command"], ucomm.get(row["pid"], ""))
            if name == "tmux" and tmux_suffix:
                name = "tmux" + tmux_suffix
            pid = row["pid"]
            out.append(
                (
                    forks[pid],
                    threads.get(pid, 0),
                    pid,
                    row["pcpu"],
                    row["stat"],
                    name,
                    acc_cpu.get(pid, 0.0),
                )
            )
        if self.sort_by == "cpu":
            out.sort(key=lambda r: (-r[6], -r[0], -r[1], r[2]))
        else:  # "forks" (default)
            out.sort(key=lambda r: (-r[0], -r[1], r[2]))
        return out

    # ----- severity (rate-based, sticky) -----

    @staticmethod
    def _trim(history: "deque[tuple[float, int]]", now: float) -> None:
        cutoff = now - RATE_WINDOW_SECONDS
        while history and history[0][0] < cutoff:
            history.popleft()

    def _update_global_severity(self, total_procs: int, now: float) -> None:
        self._trim(self.proc_history, now)
        self.proc_history.append((now, total_procs))
        self.rate = compute_rate(self.proc_history, total_procs, now)
        prev = self.severity
        self.severity = apply_hysteresis(
            self.severity, self.rate,
            RATE_WARM_ENTRY, RATE_HOT_ENTRY, RATE_COOL_ENTRY,
        )
        if self.severity != prev:
            log.info(
                "global severity transition: %s → %s (rate=%+.2f/s procs=%d)",
                prev, self.severity, self.rate, total_procs,
            )

    def _update_pid_severity(
        self, snap: list[tuple[int, int, int, str, str, str, float]], now: float
    ) -> None:
        live_pids = set()
        for forks_n, _, pid, _, _, name, _ in snap:
            live_pids.add(pid)
            hist = self.pid_history.setdefault(pid, deque())
            self._trim(hist, now)
            hist.append((now, forks_n))
            rate = compute_rate(hist, forks_n, now)
            prev = self.pid_severity.get(pid, "cold")
            new = apply_hysteresis(
                prev, rate,
                PROC_WARM_ENTRY, PROC_HOT_ENTRY, PROC_COOL_ENTRY,
            )
            self.pid_severity[pid] = new
            if new != prev:
                log.info(
                    "pid severity transition: %s → %s pid=%d name=%s rate=%+.2f/s forks=%d",
                    prev, new, pid, name, rate, forks_n,
                )
        for pid in list(self.pid_history):
            if pid not in live_pids:
                del self.pid_history[pid]
                self.pid_severity.pop(pid, None)

    # ============================================================================
    # OVERRIDE POINTS — Phases 3 & 4 will replace these four methods.
    # ============================================================================
    #
    # The create_*_view methods return an NSView. The update_*_view methods
    # mutate it in place — never destroy and rebuild on tick, both for
    # flicker reasons and because mid-popover layout thrash is jarring.
    #
    # Contract:
    #   - row_data is a 7-tuple matching watch-forks's snapshot row, or None
    #     when called by syncRowCount_ to construct a fresh blank slot
    #     (the next _update_row_view call immediately populates it).
    #   - bar_context is {bar_max: float, name_width: int} — shared across
    #     all rows in a tick. None ⇔ blank construction.
    #   - launchd_data is the 7-tuple for PID 1 (the row data), or None
    #     when no data has been collected yet.
    #
    # Phase 3: replace _create_row_view to return a composite NSView
    # (icon + name label + fork-count gauge + CPU gauge + sparkline).
    # Phase 4: replace _create_header_view with a multi-sparkline view
    # (total procs, total CPU, fork rate over time).

    def _create_row_view(self, row_data, bar_context):
        """Construct a row view from a snapshot tuple.

        Phase 3: returns a RichRowView — composite NSView with severity
        glyph, process icon, name label, sparkline, heat gauge, and CPU%
        label. The (row_data, bar_context) contract is unchanged so the
        app's tick loop needs no modification."""
        total_w = (
            _COL_SPACING
            + _COL_SEV_W + _COL_SPACING
            + _COL_ICON_W + _COL_SPACING
            + _COL_NAME_W + _COL_SPACING
            + _COL_SPARK_W + _COL_SPACING
            + _COL_GAUGE_W + _COL_SPACING
            + _COL_CPU_W + _COL_SPACING
        )
        view = RichRowView.alloc().initWithFrame_(NSMakeRect(0.0, 0.0, total_w, _ROW_H))
        view.setApp_(self)
        # Populate immediately if data is available so the view is never
        # blank between creation and the first tick update.
        if row_data is not None and bar_context is not None:
            self._update_row_view(view, row_data, bar_context)
        return view

    def _update_row_view(self, view, row_data, bar_context):
        """Mutate the row view's display to reflect new data.

        Phase 3: delegates to RichRowView.apply_update() which updates all
        subviews (severity image, process icon, name, sparkline, gauge,
        CPU label) in place — no views are destroyed or recreated."""
        if isinstance(view, RichRowView):
            view.apply_update(row_data, bar_context, self.pid_history, self.pid_severity)
        else:
            # Fallback for any non-RichRowView (shouldn't happen in Phase 3,
            # but keeps the app alive if the view pool is in a mixed state).
            forks_n, threads_n, pid, pcpu, stat, name, acc_cpu = row_data
            bar_max = bar_context["bar_max"]
            name_width = bar_context["name_width"]
            bar_value = acc_cpu if self.sort_by == "cpu" else float(forks_n)
            bar_str = bar(int(bar_value * 10), int(max(bar_max, 0.1) * 10), width=8)
            row_emoji = SEV_BY_STATE[self.pid_severity.get(pid, "cold")]
            display = (
                f"{row_emoji} {forks_n:>3} {bar_str} "
                f"{acc_cpu:>6.1f}%  {fmt_name(name, name_width)}"
            )
            if hasattr(view, "setStringValue_"):
                view.setStringValue_(display)
            if isinstance(view, _PlaceholderRowView):
                view.setRowApp_pid_name_(self, pid, name)

    def _create_header_view(self, launchd_data, global_state):
        """Construct the header view.

        Phase 4: return a HeaderOverviewView with three sparkline panels
        (CPU · PROCS · RATE). launchd_data and global_state may be None /
        empty at construction time — the view renders neutral defaults
        until the first real tick populates it."""
        view = HeaderOverviewView.alloc().initWithFrame_(
            NSMakeRect(0, 0, POPOVER_WIDTH, HeaderOverviewView.HEADER_HEIGHT)
        )
        view.setTranslatesAutoresizingMaskIntoConstraints_(False)
        if global_state:
            view.update_data(global_state)
        return view

    def _update_header_view(self, view, launchd_data, global_state):
        """Mutate the header view to reflect new data.

        Phase 4: push fresh global_state into the HeaderOverviewView so
        its three sparkline panels redraw. launchd_data is accepted for
        API compatibility but the sparkline panels use totals from
        global_state rather than the PID-1 row directly.
        """
        if isinstance(view, HeaderOverviewView) and global_state:
            view.update_data(global_state)

    # ============================================================================
    # END OVERRIDE POINTS
    # ============================================================================

    # ----- render (mutates existing views in place) -----

    def _tick(self) -> None:
        # Late-bind the status item to togglePopover_ once it exists.
        self._maybe_rebind_status_item()

        try:
            snap = self._collect()
        except subprocess.CalledProcessError:
            self.title = "⚠️ ps?"
            return
        self._last_snapshot = snap
        now = time.time()
        total_procs = len(snap)
        self._update_global_severity(total_procs, now)
        self._update_pid_severity(snap, now)

        # Phase 4: track total CPU history for the header sparkline.
        # total_cpu is computed below; we need a forward reference, so we
        # compute it here and reuse the value in the title block.
        total_cpu = sum(parse_pcpu(pcpu) for _, _, _, pcpu, _, _, _ in snap)

        # cpu_history: trim the window and append the fresh sample.
        self._trim(self.cpu_history, now)
        self.cpu_history.append((now, total_cpu))

        # Title — emoji · total procs · summed CPU% · trend.
        # Σ pcpu over every row = system-wide CPU%. By construction
        # this equals the root's subtree-accumulated value (launchd
        # is ancestor of every user process), so the top row in the
        # popover carries the same number as the menubar title.
        # (total_cpu already computed above for cpu_history tracking.)
        emoji = SEV_BY_STATE[self.severity]
        # CPU trend — sample-to-sample delta with asymmetric hysteresis.
        # First tick has no prior sample → seed steady and skip the
        # transition log line.
        if self.last_total_cpu is None:
            cpu_delta = 0.0
        else:
            cpu_delta = total_cpu - self.last_total_cpu
        prev_trend = self.cpu_trend
        self.cpu_trend = cpu_trend_state(
            prev_trend, cpu_delta, CPU_TREND_ENTRY, CPU_TREND_EXIT,
        )
        if self.cpu_trend != prev_trend:
            log.info(
                "cpu trend transition: %s → %s (delta=%+.1f%% cpu=%.1f%%)",
                prev_trend, self.cpu_trend, cpu_delta, total_cpu,
            )
        self.last_total_cpu = total_cpu
        trend_glyph = TREND_BY_STATE[self.cpu_trend]
        self.title = f"{emoji} {total_procs} / {total_cpu:.0f}% {trend_glyph}"

        # If the popover hasn't been built yet, the menubar title is the
        # only visible surface — bail before touching view hierarchies.
        if self._vc is None:
            return

        # Header — PID 1 (launchd) details plus global state for sparklines.
        pid1 = next((r for r in snap if r[2] == 1), None)
        global_state = {
            "severity": self.severity,
            "rate": self.rate,
            "cpu_trend": self.cpu_trend,
            "proc_history": list(self.proc_history),
            "cpu_history": list(self.cpu_history),
            "total_cpu": total_cpu,
            "total_procs": total_procs,
        }
        self._update_header_view(self._vc._header_view, pid1, global_state)

        # Rows — mutate the view pool in place; resize the pool to match
        # the active top-N, then update each visible row.
        # Bar value tracks the active sort dimension so the gauge stays
        # visually aligned with whichever number is driving the order.
        # PID 1 (launchd) is always filtered out — its data is in the
        # header above; including it in the rows would distort the bar
        # scale (its forks/CPU dwarf every other process by orders of
        # magnitude) and duplicate information.
        display_snap = [r for r in snap if r[2] != 1]
        top_n = min(self.top, len(display_snap))
        if self.sort_by == "cpu":
            bar_max = display_snap[0][6] if display_snap else 0.0
        else:
            bar_max = float(display_snap[0][0]) if display_snap else 0.0
        name_width = max((len(r[5]) for r in display_snap[:top_n]), default=16)
        name_width = min(max(name_width, 16), 28)
        self._bar_context = {"bar_max": bar_max, "name_width": name_width}

        # Resize the row stack to top_n slots (cheap when unchanged).
        self._vc.syncRowCount_(top_n)
        for i in range(top_n):
            self._update_row_view(
                self._vc._row_views[i], display_snap[i], self._bar_context
            )

    # ----- per-row context menu -----

    def _build_row_context_menu(self, pid: int, name: str) -> NSMenu:
        """Construct the right-click context menu for a row view. Built
        fresh on each right-click — the cost is microseconds, and rebuilding
        avoids keeping per-row NSMenu state across ticks."""
        # Lazy-init the shared action target — one instance per app,
        # shared across all rows. We carry the (pid, name) per item via
        # representedObject so the target methods know which row fired.
        if self._menu_action_target is None:
            self._menu_action_target = _MenuActionTarget.alloc().initWithApp_(self)
        target = self._menu_action_target

        menu = NSMenu.alloc().init()
        menu.setAutoenablesItems_(False)

        # Per-row detail header — informational only.
        # Pull the latest data for this PID from the last snapshot so the
        # menu always shows current numbers even if the row hasn't been
        # rendered yet this tick.
        row = next((r for r in self._last_snapshot if r[2] == pid), None)
        if row is not None:
            forks_n, threads_n, _, pcpu, stat, _, acc_cpu = row
            for line in (
                f"PID         {pid}",
                f"Forks       {forks_n}",
                f"Threads     {threads_n}",
                f"CPU (self)  {parse_pcpu(pcpu):>5.1f}%",
                f"CPU (tree)  {acc_cpu:>5.1f}%",
                f"State       {decode_stat(stat)}",
            ):
                it = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_(
                    line, None, ""
                )
                it.setEnabled_(False)
                # Use the same monospaced font for alignment.
                attr = NSAttributedString.alloc().initWithString_attributes_(
                    line, _MONO_ATTRS
                )
                it.setAttributedTitle_(attr)
                menu.addItem_(it)
            menu.addItem_(NSMenuItem.separatorItem())

        # Actions.
        copy_it = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_(
            "Copy PID", b"invokeCopyPID:", ""
        )
        copy_it.setTarget_(target)
        copy_it.setRepresentedObject_(pid)
        menu.addItem_(copy_it)

        am_it = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_(
            "Show in Activity Monitor", b"invokeShowActivity:", ""
        )
        am_it.setTarget_(target)
        am_it.setRepresentedObject_(pid)
        menu.addItem_(am_it)

        menu.addItem_(NSMenuItem.separatorItem())

        term_it = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_(
            "Send SIGTERM (15)", b"invokeSIGTERM:", ""
        )
        term_it.setTarget_(target)
        term_it.setRepresentedObject_([pid, name])
        menu.addItem_(term_it)

        kill_it = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_(
            "Send SIGKILL (9)", b"invokeSIGKILL:", ""
        )
        kill_it.setTarget_(target)
        kill_it.setRepresentedObject_([pid, name])
        menu.addItem_(kill_it)

        return menu

    # ----- callbacks -----

    def _refresh_now(self, _sender) -> None:
        self._tick()

    def _apply_interval(self, sec: float) -> None:
        self.interval = sec
        self._persist_settings()
        self._reschedule_timer()
        self._tick()

    def _apply_top(self, n: int) -> None:
        self.top = n
        self._persist_settings()
        self._tick()

    def _apply_sort(self, key: str) -> None:
        self.sort_by = key
        self._persist_settings()
        log.info("sort_by → %s", key)
        self._tick()

    def _toggle_login(self, _sender) -> None:
        # Modal alert follows — close the popover first so the alert isn't
        # trapped underneath it.
        self._close_popover_if_shown()
        if is_login_enabled():
            ok = disable_login()
            if ok:
                floating_alert(
                    title="Start at login disabled",
                    message=(
                        "watch-forks-menubar will no longer launch at login.\n\n"
                        "The currently-running instance is unaffected."
                    ),
                )
        else:
            ok = enable_login()
            if ok:
                floating_alert(
                    title="Start at login enabled",
                    message=(
                        "watch-forks-menubar will launch automatically at your "
                        "next macOS login.\n\n"
                        f"LaunchAgent: {LAUNCH_AGENT_PATH}"
                    ),
                )

    def _make_copy_pid(self, pid: int) -> Callable:
        def _cb(_sender):
            subprocess.run(["pbcopy"], input=str(pid), text=True, check=False)
        return _cb

    def _make_show_activity_monitor(self, pid: int) -> Callable:
        def _cb(_sender):
            # AM doesn't accept a PID arg, but opening it is still useful.
            subprocess.run(["open", "-a", "Activity Monitor"], check=False)
        return _cb

    def _make_kill(self, pid: int, name: str, sig: int) -> Callable:
        sig_name = "SIGKILL (-9)" if sig == signal.SIGKILL else "SIGTERM (-15)"

        def _cb(_sender):
            log.info("kill action invoked: pid=%d name=%s sig=%s", pid, name, sig_name)
            # Confirmation modal follows — close popover so it isn't trapped
            # behind it.
            self._close_popover_if_shown()
            resp = floating_alert(
                title=f"Send {sig_name}?",
                message=f"PID {pid}  ({name})\n\nThis cannot be undone.",
                ok="Send signal",
                cancel="Cancel",
            )
            if resp != 1:
                log.info("kill cancelled by operator: pid=%d", pid)
                return
            try:
                os.kill(pid, sig)
                log.info("os.kill succeeded: pid=%d sig=%s", pid, sig_name)
            except ProcessLookupError:
                log.warning("os.kill: no such process pid=%d", pid)
                floating_alert(title="No such process", message=f"PID {pid}")
            except PermissionError:
                log.warning("os.kill permission denied: pid=%d", pid)
                floating_alert(
                    title="Permission denied",
                    message=(
                        f"Cannot signal PID {pid} ({name}).\n"
                        "Try running watch-forks-menubar with sudo, or kill\n"
                        "the process from a privileged shell."
                    ),
                )
            except Exception:
                log.exception("os.kill failed unexpectedly: pid=%d", pid)
            # rumps.notification() depends on a bundled Info.plist with
            # CFBundleIdentifier, which a plain python3 interpreter lacks
            # — guard so a missing notification center can't abort the
            # refresh below.
            try:
                rumps.notification(
                    title="watch-forks",
                    subtitle=f"Sent {sig_name} to {pid}",
                    message=name,
                )
            except Exception as e:
                log.debug("notification skipped (%s)", type(e).__name__)
            # Always refresh — even on failure, the user expects the menu
            # to reflect current reality after the action.
            try:
                self._tick()
            except Exception:
                log.exception("post-kill tick failed")
        return _cb

    def _open_terminal(self, _sender) -> None:
        # `clear &&` wipes the new shell's prompt + command-echo line before
        # watch-forks paints, so the operator sees a clean table immediately
        # instead of a half-second flash of "shell$ /path/to/watch-forks ...".
        # In Manual mode (interval==0) we'd pass -i 0 → tight loop in
        # watch-forks; fall back to DEFAULT_INTERVAL for the terminal run.
        # Close popover before launching Terminal so focus transfer doesn't
        # leave a stale popover hanging.
        self._close_popover_if_shown()
        term_interval = self.interval if self.interval > 0 else DEFAULT_INTERVAL
        script = (
            'tell application "Terminal"\n'
            '    activate\n'
            f'    do script "clear && {WATCH_FORKS_PATH} -i {term_interval:g} -n 50"\n'
            'end tell'
        )
        subprocess.run(["osascript", "-e", script], check=False)

    # ----- timer + persistence -----

    def _reschedule_timer(self) -> None:
        """Invalidate any existing timer and schedule a new one in
        NSRunLoopCommonModes. NSPopover (unlike NSMenu) doesn't strictly
        suspend the default mode while it's open, but common modes is
        harmless and keeps the driver consistent for any future tracking
        modes (e.g., NSEventTrackingRunLoopMode during a popover drag).

        Manual mode (interval == 0.0) leaves no timer armed — the data
        only updates when the operator picks "Refresh" or the popover
        is toggled open (which forces a pre-show tick)."""
        if self._ns_timer is not None:
            self._ns_timer.invalidate()
            self._ns_timer = None
        if self.interval <= 0:
            log.info("timer not scheduled: interval=manual")
            return
        self._ns_timer = NSTimer.timerWithTimeInterval_target_selector_userInfo_repeats_(
            self.interval, self._tick_handler, b"fire:", None, True
        )
        NSRunLoop.currentRunLoop().addTimer_forMode_(
            self._ns_timer, NSRunLoopCommonModes
        )
        log.info("timer scheduled: interval=%.1fs (NSRunLoopCommonModes)", self.interval)

    def _persist_settings(self) -> None:
        save_settings({
            "interval": self.interval,
            "top": self.top,
            "sort_by": self.sort_by,
        })


def main() -> int:
    WatchForksApp().run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
